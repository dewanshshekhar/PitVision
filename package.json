{
  "name": "pitvision",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "PitVision — live track condition detector. Real-time CV engine + periodic AI verification.",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
