# Copy to .env and fill in. The key stays server-side — it is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# ── Server ─────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info                       # debug | info | warn | error
PITVISION_DB=data/pitvision.db       # SQLite file; created on first boot

# Bearer token required on every API call except /api/health and /api/ready.
# Empty means auth is off, which is fine for a laptop serving itself and not
# fine the moment the port is reachable by anything else.
PITVISION_API_TOKEN=

# Set when a reverse proxy terminates TLS, so x-forwarded-for is trusted for
# rate-limit keying. Leave off otherwise: the header is client-supplied, and
# honouring it unconditionally lets anyone reset their own bucket.
PITVISION_TRUST_PROXY=false

# ── Verification ───────────────────────────────────────────────────────
PITVISION_MODEL=claude-opus-5
PITVISION_VERIFY_TIMEOUT_MS=20000
PITVISION_VERIFY_RETRIES=1
PITVISION_VERIFY_RPM=30              # per client — this endpoint costs money
PITVISION_INGEST_RPM=600

# Cost accounting, USD per million tokens. Defaults match Claude Opus 5.
PITVISION_PRICE_INPUT_PER_MTOK=5
PITVISION_PRICE_OUTPUT_PER_MTOK=25

# ── Monitoring thresholds ──────────────────────────────────────────────
PITVISION_MONITOR_TICK_MS=2000
PITVISION_STALL_MS=6000              # no readings for this long = feed stalled
PITVISION_LATENCY_BUDGET_MS=100      # end-to-end budget the p95 is judged against
PITVISION_LATENCY_BREACH_RATIO=0.05  # share of frames allowed over budget
PITVISION_DRIFT_MIN_SAMPLES=6        # verifications needed before drift means anything
PITVISION_DRIFT_FLOOR=0.5            # agreement below this opens a drift incident
PITVISION_VERIFY_FAIL_STREAK=3
PITVISION_INSTABILITY_FLIPS=6        # condition changes that count as strobing
PITVISION_INSTABILITY_WINDOW_MS=30000
PITVISION_SURGE_PER_MIN=14           # sustained index climb worth interrupting for

# ── Retention ──────────────────────────────────────────────────────────
PITVISION_RETENTION_DAYS=30          # readings older than this are pruned hourly
PITVISION_SESSION_IDLE_MS=300000     # silent sessions are auto-closed as abandoned
